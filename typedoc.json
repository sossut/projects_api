{
  "entryPoints": ["src"],
  "out": "docs",
  "tsconfig": "tsconfig.json",
  "exclude": ["**/*.test.ts", "test/**", "dist/**", "node_modules/**"],
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true,
